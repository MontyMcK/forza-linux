# Copy to tools/ps5/ps5.env (gitignored) and fill in for your console.
# Every tools/ps5 script reads it.

PS5_IP=192.168.1.x
PS5_FTP_PORT=2121            # ftpsrv
PS5_ELFLDR_PORT=9021         # ps5-payload-dev/elfldr
PS5_PLDMGR_PORT=8084         # pldmgr's web API, starts elfldr when it isn't listening

# Title (tools/ps5/package.sh output goes here, ShadowMount+ registers it)
PS5_TITLE_ID=PPSA99642
PS5_TITLE_REMOTE=/data/homebrew/PPSA99642

PS5_ELFLDR_PLDMGR=/data/pldmgr/payloads/elfldr/elfldr-ps5.elf   # started via pldmgr when 9021 is closed

# Logs: files on the console, pulled over FTP into research/private/ps5-logs/
PS5_LOG_REMOTE=/data/homebrew/PPSA99642/logs

# Your own dump on the console (the folder that holds forza_durango_release_final.exe).
# Only tools/ps5/upload_dump.sh writes here, and only with --i-was-asked.
PS5_DUMP_REMOTE=/mnt/usb0/Anthem_1.0.0.64_x64__8wekyb3d8bbwe/Mount

# Payload SDK (ps5-payload-dev/sdk release, unzipped)
PS5_PAYLOAD_SDK=$HOME/ps5-payload-sdk

# This PC: the title sends its log lines here (tools/ps5/netlog.py listens)
PS5_LOG_HOST=192.168.1.x
PS5_LOG_PORT=9599
