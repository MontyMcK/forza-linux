+  template<typename ContextType>
+  void D3D11CommonContext<ContextType>::ApplyXboxRemap(
+    const D3D11XboxRemap&                   Remap) {
+    auto dst = D3D11ShaderType(Remap.dstStage);
+    auto src = D3D11ShaderType(Remap.srcStage);
+
+    switch (Remap.kind) {
+      case 0: {
+        if (Remap.dstSlot >= D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT
+         || Remap.srcSlot >= D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT)
+          return;
+        const auto& b = m_state.cbv[src].buffers[Remap.srcSlot];
+        BindConstantBuffer(dst, Remap.dstSlot, b.buffer.ptr(), b.constantOffset, b.constantBound);
+      } break;
+
+      case 1:
+        if (Remap.dstSlot >= D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT
+         || Remap.srcSlot >= D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT)
+          return;
+        BindShaderResource(dst, Remap.dstSlot, m_state.srv[src].views[Remap.srcSlot].ptr());
+        break;
+
+      case 2:
+        if (Remap.dstSlot >= D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT
+         || Remap.srcSlot >= D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT)
+          return;
+        BindSampler(dst, Remap.dstSlot, m_state.samplers[src].samplers[Remap.srcSlot].ptr());
+        break;
+
+      case 3: {
+        if (Remap.dstSlot >= D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT
+         || Remap.srcSlot >= D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT)
+          return;
+        const auto& v = m_state.ia.vertexBuffers[Remap.srcSlot];
+        BindVertexBuffer(Remap.dstSlot, v.buffer.ptr(), v.offset, v.stride);
+      } break;
+    }
+  }
+
