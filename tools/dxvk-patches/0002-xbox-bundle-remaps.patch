+// forza-linux: entry point for the Xbox runtime (bundle contexts only).
+extern "C" DLLEXPORT void dxvk_xbox_remap_inheritance(
+        ID3D11DeviceContext*  pContext,
+        UINT                  Kind,
+        UINT                  DstStage,
+        UINT                  DstSlot,
+        UINT                  SrcStage,
+        UINT                  SrcSlot) {
+  if (!pContext || pContext->GetType() != D3D11_DEVICE_CONTEXT_DEFERRED)
+    return;
+
+  auto context = static_cast<dxvk::D3D11DeferredContext*>(pContext);
+
+  if (context->GetContextFlags() & dxvk::D3D11_CONTEXT_FLAG_XBOX_BUNDLE)
+    context->XboxRemapInheritance(Kind, DstStage, DstSlot, SrcStage, SrcSlot);
+}
