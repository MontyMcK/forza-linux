+    /**
+     * \brief forza-linux: leaves chunks out of the chunk-count heuristic
+     *
+     * An Xbox draw bundle replays as many small CS chunks (one per inheritance
+     * remap), which made every bundle look like a big batch of work and
+     * caused hundreds of submissions (and render pass splits) per frame.
+     * \param [in] count Number of chunks just dispatched that should not count
+     */
+    void ignoreChunks(
+            uint64_t              count) {
+      m_lastFlushChunkId += count;
+    }
