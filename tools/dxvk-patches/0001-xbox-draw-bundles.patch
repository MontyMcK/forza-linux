index 83456e1d..6b5e0520 100644
--- a/src/d3d11/d3d11_cmdlist.h
+++ b/src/d3d11/d3d11_cmdlist.h
@@ -5,6 +5,12 @@
 #include "d3d11_context.h"
 
 namespace dxvk {
+
+  // forza-linux: a deferred context created with this flag records an Xbox
+  // "draw bundle": its command list runs on the executing context's current
+  // state (render targets, viewports, bindings) instead of a cleared one, and
+  // the executing context's state is restored afterwards.
+  constexpr UINT D3D11_CONTEXT_FLAG_XBOX_BUNDLE = 0x20000;
   
   using D3D11ChunkDispatchProc = std::function<uint64_t (DxvkCsChunkRef&&, uint64_t, GpuFlushType)>;
 
