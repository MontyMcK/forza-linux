+  template<typename ContextType>
+  void D3D11CommonContext<ContextType>::RestoreXboxTouched(
+    const D3D11XboxTouched&                 Touched) {
+    if (Touched.framebuffer)
+      BindFramebuffer();
+
+    if (Touched.shaders & (1u << uint32_t(D3D11ShaderType::eVertex)))
+      BindShader<D3D11ShaderType::eVertex>(GetCommonShader(m_state.vs.ptr()));
+    if (Touched.shaders & (1u << uint32_t(D3D11ShaderType::eHull)))
+      BindShader<D3D11ShaderType::eHull>(GetCommonShader(m_state.hs.ptr()));
+    if (Touched.shaders & (1u << uint32_t(D3D11ShaderType::eDomain)))
+      BindShader<D3D11ShaderType::eDomain>(GetCommonShader(m_state.ds.ptr()));
+    if (Touched.shaders & (1u << uint32_t(D3D11ShaderType::eGeometry)))
+      BindShader<D3D11ShaderType::eGeometry>(GetCommonShader(m_state.gs.ptr()));
+    if (Touched.shaders & (1u << uint32_t(D3D11ShaderType::ePixel)))
+      BindShader<D3D11ShaderType::ePixel>(GetCommonShader(m_state.ps.ptr()));
+    if (Touched.shaders & (1u << uint32_t(D3D11ShaderType::eCompute)))
+      BindShader<D3D11ShaderType::eCompute>(GetCommonShader(m_state.cs.ptr()));
+
+    if (Touched.layout)       ApplyInputLayout();
+    if (Touched.topology)     ApplyPrimitiveTopology();
+    if (Touched.blend)        ApplyBlendState();
+    if (Touched.blendFactor)  ApplyBlendFactor();
+    if (Touched.dss)          ApplyDepthStencilState();
+    if (Touched.stencilRef)   ApplyStencilRef();
+    if (Touched.rs)           ApplyRasterizerState();
+    if (Touched.rsSamples)    ApplyRasterizerSampleCount();
+    if (Touched.viewports)    ApplyViewportState();
+
+    if (Touched.ib) {
+      BindIndexBuffer(
+        m_state.ia.indexBuffer.buffer.ptr(),
+        m_state.ia.indexBuffer.offset,
+        m_state.ia.indexBuffer.format);
+    }
+
+    for (uint32_t i = 0; i < m_state.ia.vertexBuffers.size() && i < 32u; i++) {
+      if (Touched.vb & (1u << i)) {
+        BindVertexBuffer(i,
+          m_state.ia.vertexBuffers[i].buffer.ptr(),
+          m_state.ia.vertexBuffers[i].offset,
+          m_state.ia.vertexBuffers[i].stride);
+      }
+    }
+
+    if (Touched.xfb) {
+      for (uint32_t i = 0; i < m_state.so.targets.size(); i++)
+        BindXfbBuffer(i, m_state.so.targets[i].buffer.ptr(), ~0u);
+    }
+
+    ResetDirtyTracking();
+
+    for (uint32_t s = 0; s < D3D11ShaderTypeCount; s++) {
+      auto stage = D3D11ShaderType(s);
+
+      const auto& cbv = m_state.cbv[stage];
+      for (uint32_t i = 0; i < cbv.buffers.size() && i < 32u; i++) {
+        if (Touched.cbv[s] & (1u << i)) {
+          BindConstantBuffer(stage, i, cbv.buffers[i].buffer.ptr(),
+            cbv.buffers[i].constantOffset, cbv.buffers[i].constantBound);
+        }
+      }
+
+      const auto& srv = m_state.srv[stage];
+      for (uint32_t i = 0; i < srv.views.size() && i < 128u; i++) {
+        if (Touched.srv[s][i / 64u] & (uint64_t(1u) << (i % 64u)))
+          BindShaderResource(stage, i, srv.views[i].ptr());
+      }
+
+      const auto& smp = m_state.samplers[stage];
+      for (uint32_t i = 0; i < smp.samplers.size() && i < 32u; i++) {
+        if (Touched.samplers[s] & (1u << i))
+          BindSampler(stage, i, smp.samplers[i].ptr());
+      }
+    }
+
+    if (Touched.uav) {
+      RestoreUnorderedAccessViews(D3D11ShaderType::ePixel);
+      RestoreUnorderedAccessViews(D3D11ShaderType::eCompute);
+    }
+
+    SetDrawBuffers(nullptr, nullptr);
+  }
