+  /**
+   * \brief forza-linux: the state an Xbox draw bundle binds
+   *
+   * Recorded while the bundle is recorded; after the bundle runs, the
+   * executing context re-applies only these pieces of its own state
+   * (instead of resetting and restoring everything, ~380 times a frame).
+   */
+  struct D3D11XboxTouched {
+    uint32_t shaders      = 0u;   ///< bit per D3D11ShaderType
+    uint32_t cbv[6]       = { };  ///< constant buffer slots per stage
+    uint64_t srv[6][2]    = { };  ///< shader resource slots 0-127 per stage
+    uint32_t samplers[6]  = { };  ///< sampler slots per stage
+    uint32_t vb           = 0u;   ///< vertex buffer slots
+    bool uav = false, ib = false, layout = false, topology = false, blend = false,
+         blendFactor = false, dss = false, stencilRef = false, rs = false,
+         rsSamples = false, viewports = false, framebuffer = false, xfb = false;
+
+    void merge(const D3D11XboxTouched& o) {
+      shaders |= o.shaders;
+      vb |= o.vb;
+      for (uint32_t i = 0; i < 6; i++) {
+        cbv[i] |= o.cbv[i];
+        srv[i][0] |= o.srv[i][0];
+        srv[i][1] |= o.srv[i][1];
+        samplers[i] |= o.samplers[i];
+      }
+      uav |= o.uav; ib |= o.ib; layout |= o.layout; topology |= o.topology;
+      blend |= o.blend; blendFactor |= o.blendFactor; dss |= o.dss;
+      stencilRef |= o.stencilRef; rs |= o.rs; rsSamples |= o.rsSamples;
+      viewports |= o.viewports; framebuffer |= o.framebuffer; xfb |= o.xfb;
+    }
+
+    void touchAll() {
+      shaders = ~0u; vb = ~0u;
+      for (uint32_t i = 0; i < 6; i++) {
+        cbv[i] = ~0u; srv[i][0] = ~0ull; srv[i][1] = ~0ull; samplers[i] = ~0u;
+      }
+      uav = ib = layout = topology = blend = blendFactor = dss = stencilRef = rs =
+        rsSamples = viewports = framebuffer = xfb = true;
+    }
+
+    void touchSrv(uint32_t stage, uint32_t slot) {
+      if (slot < 128u)
+        srv[stage][slot / 64u] |= uint64_t(1u) << (slot % 64u);
+    }
+  };
